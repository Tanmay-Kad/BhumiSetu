generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum Role {
  CITIZEN
  OFFICER
  ADMIN
}

enum ApplicationType {
  BUILDING_PERMISSION
  TREE_CUTTING
  UTILITY_CONNECTION
  LAND_USE_CHANGE
  OTHER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFO_REQUIRED
  RESUBMITTED
  APPROVED
  APPROVED_WITH_CONDITIONS
  REJECTED
  COMPLETED
  CANCELLED
}

enum DocumentType {
  IDENTITY_PROOF
  SALE_DEED
  LAND_RECORD
  SITE_PLAN
  BUILDING_PLAN
  PROPERTY_TAX_RECEIPT
  TREE_RELATED_DOCUMENT
  UTILITY_DOCUMENT
  OTHER
}

enum ApplicationAction {
  APPLICATION_CREATED
  APPLICATION_SUBMITTED
  REVIEW_STARTED
  ADDITIONAL_INFO_REQUESTED
  APPLICATION_RESUBMITTED
  APPLICATION_APPROVED
  APPLICATION_APPROVED_WITH_CONDITIONS
  APPLICATION_REJECTED
  APPLICATION_CANCELLED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_UNDER_REVIEW
  APPLICATION_ADDITIONAL_INFO_REQUIRED
  APPLICATION_RESUBMITTED
  APPLICATION_APPROVED
  APPLICATION_APPROVED_WITH_CONDITIONS
  APPLICATION_REJECTED
  APPLICATION_CANCELLED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?  @unique
  role         Role     @default(CITIZEN)
  isActive     Boolean  @default(true)
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerships           Ownership[]
  citizenApplications  Application[] @relation("CitizenApplications")
  assignedApplications Application[] @relation("AssignedOfficerApplications")
  uploadedDocuments    ApplicationDocument[] @relation("UploadedApplicationDocuments")
  applicationHistory   ApplicationHistory[] @relation("ApplicationHistoryActor")
  notifications        Notification[]

  @@map("users")
}

model Parcel {
  id           String                       @id @default(uuid())
  ulpin        String                       @unique
  surveyNumber String
  village      String
  taluk        String
  district     String
  area         Float
  geometry     Unsupported("geometry")?
  landUse      String
  zoning       String
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  ownerships   Ownership[]
  applications Application[]

  @@map("parcels")
}

model Ownership {
  id        String   @id @default(uuid())
  userId    String
  parcelId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcel Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)

  @@unique([userId, parcelId])
  @@map("ownerships")
}

model Department {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  applications Application[]

  @@map("departments")
}

model Application {
  id                String            @id @default(uuid())
  applicationNumber String            @unique
  type              ApplicationType
  status            ApplicationStatus @default(DRAFT)
  description       String
  parcelId          String
  citizenId         String
  departmentId      String?
  assignedOfficerId String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  decisionAt        DateTime?
  reviewRemarks     String?
  decisionRemarks   String?
  citizenResponse   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  parcel          Parcel      @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  citizen         User        @relation("CitizenApplications", fields: [citizenId], references: [id], onDelete: Restrict)
  department      Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedOfficer User?       @relation("AssignedOfficerApplications", fields: [assignedOfficerId], references: [id], onDelete: SetNull)
  documents       ApplicationDocument[]
  history         ApplicationHistory[]
  notifications   Notification[]

  @@index([citizenId])
  @@index([parcelId])
  @@index([status])
  @@index([departmentId])
  @@index([assignedOfficerId])
  @@index([createdAt])

  @@map("applications")
}

model ApplicationDocument {
  id               String       @id @default(uuid())
  applicationId    String
  uploadedById     String
  documentType     DocumentType
  originalFileName String
  storageKey       String
  mimeType         String
  fileSize         Int
  uploadedAt       DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy  User        @relation("UploadedApplicationDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([uploadedById])
  @@index([documentType])
  @@index([uploadedAt])
  @@map("application_documents")
}

model ApplicationHistory {
  id         String           @id @default(uuid())
  applicationId String
  actorId    String?
  action     ApplicationAction
  fromStatus ApplicationStatus?
  toStatus   ApplicationStatus
  remarks    String?
  createdAt  DateTime         @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User?       @relation("ApplicationHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([actorId])
  @@index([createdAt])
  @@map("application_history")
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  applicationId String?
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([applicationId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
